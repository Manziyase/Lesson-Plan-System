[TEMPLATE]
# SQLite (default — zero-config, one file, easy backups). Local dev only:
# Vercel's filesystem is read-only/ephemeral, so a SQLite file cannot live there.
DATABASE_URL="file:./dev.db"

# Production (Vercel): switch prisma/schema.prisma to provider = "postgresql"
# and point DATABASE_URL at a hosted Postgres database.
# DATABASE_URL="postgresql://user:password@host:5432/ireme?sslmode=require"

# Optional: set to "1" to close self-registration (see /api/auth/register-status).
# REGISTRATION_CLOSED="1"
