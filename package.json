{
  "name": "ireme-next",
  "version": "2.0.0",
  "private": true,
  "description": "Ireme — Rwanda School Lesson Planning & Knowledge Management System (Next.js + Prisma)",
  "scripts": {
    "predev": "prisma db push --skip-generate",
    "dev": "next dev --turbopack -p 3100",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:seed-demo": "node scripts/seed-demo.mjs",
    "db:migrate:legacy": "node scripts/migrate-legacy.mjs",
    "db:dump-sqlite": "node scripts/export-sqlite-sql.mjs",
    "smoke": "node scripts/smoke-next.mjs",
    "postinstall": "prisma generate"
  },
  "engines": {
    "node": ">=18.18"
  },
  "license": "MIT",
  "dependencies": {
    "@prisma/client": "^6.10.0",
    "next": "^15.3.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.10",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "prisma": "^6.10.0",
    "tailwindcss": "^4.1.10",
    "typescript": "^5.8.0"
  }
}
